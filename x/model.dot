digraph DataModel {
    rankdir=LR;
    node [shape=record, fontname="monospace"];

    // Database root object
    Db [label="{Db| Dir: string\l Depth: int\l Poly: resticRabin.Pol\l MinSize: uint\l MaxSize: uint}"];

    // Path describes locations and addressing information
    Path [label="{Path| Raw: string\l Abs: string\l Rel: string\l Canon: string\l Class: string\l Algo: string\l Hash: string\l Addr: string\l Label: string}"];

    // worm is the file-level abstraction used to read/write underlying data.
    worm [label="{worm| Db: *Db\l *Path\l _mode: os.FileMode\l fh: *os.File\l hash: hash.Hash}"];

    // Tree is a Merkle tree node that holds entries (other Trees or Blocks)
    Tree [label="{Tree| Db: *Db\l *worm\l _entries: []Object\l _leaves: []Object\l currentLeaf: int64}"];

    // Block holds a data block. It is similar in structure to Tree.
    Block [label="{Block| Db: *Db\l *worm}"];

    // Stream represents an ordered data stream anchored by a Tree.
    Stream [label="{Stream| Db: *Db\l RootNode: *Tree\l Label: string\l Path: *Path}"];

    // Object is the abstraction implemented by Tree and Block.
    Object [label="{Object| +Read([]byte) (n int, err error)\l +Write([]byte) (n int, err error)\l +Seek(int64, int) (n int64, err error)\l +Tell() (int64, error)\l +Close() error\l +Size() (int64, error)\l +GetPath() *Path}"];

    // Relationships
    // Db creates and owns objects (Trees, Blocks, Streams)
    Db -> Tree [label="puts/gets", arrowhead="open"];
    Db -> Block [label="puts/gets", arrowhead="open"];
    Db -> Stream [label="creates", arrowhead="open"];

    // Both Tree and Block embed a worm, which in turn holds a Path reference.
    Tree -> worm [arrowhead="vee", label="embeds"];
    Block -> worm [arrowhead="vee", label="embeds"];
    worm -> Path [arrowhead="vee", label="has"];

    // Tree and Block fulfill the Object interface.
    Tree -> Object [style=dashed, arrowhead="empty", label="implements"];
    Block -> Object [style=dashed, arrowhead="empty", label="implements"];

    // Stream is defined in terms of a Tree and a Path.
    Stream -> Tree [arrowhead="vee", label="RootNode"];
    Stream -> Path [arrowhead="vee", label="Path"];
}
