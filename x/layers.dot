/* This graph illustrates the layered architecture for
Promisebase with "everything's a message" call flow.
Each node represents a module or layer and edges
indicate call dependencies. */
digraph Layers {
  rankdir=TB;
  node [shape=box, style=filled, fillcolor=white,
    fontname="monospace"];

  UI [label="User Interface Layer\n(CLI, Web, FUSE)"];
  MsgTimeline [label="Message & Timeline Layer\nRecordMessage(), GetMessage(), ListMessages()"];
  VCS [label="VCS Layer\nCommit(), Branch(), Merge(), Log(), Checkout()"];
  DirTree [label="Directory Tree Layer\nImport(), Export(), Diff(), Cat()"];
  Stream [label="Streaming Layer\nNewStream(), Write(), Read(), Close()"];
  Refs [label="Reference Index Layer\n(Index into Messages)\nSetRef(), GetRef(), DeleteRef(), ListRefs()"];
  HashKV [label="Content-Addressable (hashkv) Layer\nPut(), Get(), Delete()"];
  KV [label="KV Layer\nGet(), Put(), Delete()"];
  Rabin [label="Rabin Chunking\n(in-memory chunking)"];

  // New call flow: UI → [VCS, DirTree, Stream, Refs] → Message → HashKV → KV
  UI -> VCS;
  UI -> DirTree;
  UI -> Stream;
  UI -> Refs;
  
  VCS -> MsgTimeline;
  VCS -> DirTree;
  VCS -> Refs;
  DirTree -> Stream;
  DirTree -> Refs;
  Stream -> MsgTimeline;
  Refs -> MsgTimeline;
  
  MsgTimeline -> HashKV;
  HashKV -> KV;
  
  // Stream still uses Rabin for chunking
  Stream -> Rabin;

  // ContainerManager is a k8s replacement
  ContainerManager -> VCS;

  // BareMetalManager is a replacement for legacy DevOps tools
  BareMetalManager -> VCS;


}

