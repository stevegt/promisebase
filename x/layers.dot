/* This graph illustrates the layered architecture for
Promisebase. Each node represents a module or layer and edges
indicate flows. */
digraph Layers {
  rankdir=TB;
  node [shape=box, style=filled, fillcolor=white,
    fontname="monospace"];

  UI [label="User Interfaces\n(CLI, Web, FUSE)"];
  MsgTimeline [label="Message & Timeline Layer\nRecordMessage(), 
GetMessage(), ListMessages()"];
  VCS [label="VCS Layer\nCommit(), Branch(), Merge(), Log(), 
Checkout()"];
  DB [label="High-Level Database Layer\nPutBlock(), GetBlock(), 
PutTree(), GetTree()"];
  DirTree [label="Directory Tree Layer\nImport(), Export(), Diff(), 
Cat()"];
  Stream [label="Streaming Layer\nNewStream(), Write(), Read(), 
Close()"];
  Refs [label="Reference Layer\nSetRef(), GetRef(), DeleteRef(), 
ListRefs()"];
  HashKV [label="Content-Addressable (hashkv) Layer\nPut(), Get(), 
Delete()"];
  KV [label="KV Layer\nGet(), Put(), Delete()"];
  Rabin [label="Rabin Chunking\n(in-memory chunking)"];
  ContainerImage [label="Container Image\nBuildImage(), 
RunContainer()"];

  UI -> DB [label="0.90", color="green"];
  UI -> VCS [label="0.75", color="yellow"];
  UI -> ContainerImage [label="0.75", color="yellow"];
  MsgTimeline -> DB [label="0.88", color="green"];
  DB -> Stream [label="0.90", color="green"];
  DB -> DirTree [label="0.85", color="green"];
  DB -> Refs [label="0.90", color="green"];
  DB -> HashKV [label="0.90", color="green"];
  VCS -> DirTree [label="0.90", color="green"];
  VCS -> Stream [label="0.90", color="green"];
  DirTree -> HashKV [label="0.80", color="green"];
  DirTree -> Refs [label="0.85", color="green"];
  Stream -> HashKV [label="0.90", color="green"];
  Stream -> Rabin [label="0.90", color="green"];
  HashKV -> KV [label="0.95", color="green"];
  Refs -> KV [label="0.80", color="green"];
  ContainerImage -> DirTree [label="0.90", color="green"];
}
