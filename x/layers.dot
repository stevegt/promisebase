digraph Layers {
  rankdir=BT;
  node [shape=box, style=filled, fillcolor=white,
  fontname="monospace"];

  KV [label="KV Layer\n(Raw File Storage)"];
  HashKV [label="Content-Addressable\n(hashkv) Layer"];
  DB [label="High-Level Database\n(db) Layer"];
  Msg [label="Message & Timeline\nLayer"];
  UI [label="User Interfaces\n(CLI, Web, FUSE)"];

  // Connect KV to HashKV with a high success probability
  KV -> HashKV [label="0.95", color="green"];
  // Connect HashKV to DB
  HashKV -> DB [label="0.90", color="green"];
  // Connect DB to Message/Timeline layer
  DB -> Msg [label="0.85", color="green"];
  // Connect DB to UI layer (primary interface)
  DB -> UI [label="0.90", color="green"];
  // Allow Message layer to also feed UI
  Msg -> UI [label="0.75", color="yellow"];
  // A fallback path from HashKV directly to UI is less promising
  HashKV -> UI [label="0.65", color="red"];
}
