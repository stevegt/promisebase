// tempDirReadCloser wraps an io.ReadCloser and a temporary directory path.
// When closed it will close the underlying reader and remove the temp directory.
type tempDirReadCloser struct {
	io.ReadCloser
	tmpDir string
}

func (t *tempDirReadCloser) Close() error {
	err1 := t.ReadCloser.Close()
	err2 := os.RemoveAll(t.tmpDir)
	if err1 != nil {
		return err1
	}
	return err2
}

type Container struct {
	Path string
	Args []string
	Cid  string
	Name string
	Rc   int
	Errc chan error
	dir  string
	pit  *Pit
	*exec.Cmd
}

// startContainer starts a container from a db tree
func (pit *Pit) startContainer(cntr *Container) (err error) {
	defer Return(&err)

	err = cntr.initdir()
	Ck(err, "initdir failed")

	err = cntr.initconfig()
	Ck(err, "initconfig failed")

	err = cntr.createRootFsFromTree()
	Ck(err, "createrootfs failed")

	err = cntr.start()
	Ck(err, "start failed")

	return
}

func (cntr *Container) Delete() (err error) {
	// XXX check to see if container is already gone
	runc := exec.Command("sudo", "runc", "delete", cntr.Name)
	// XXX log?
	runc.Stdout = os.Stdout
	runc.Stderr = os.Stderr
	err = runc.Start()
	Ck(err)
	err = runc.Wait()
	Ck(err)
	// XXX remove bundle dir
	return
}

func (cntr *Container) Wait() (err error) {
	err = cntr.Cmd.Wait()
	cntr.Rc = cntr.Cmd.ProcessState.ExitCode()
	return
}

func (cntr *Container) initdir() (err error) {
	defer Return(&err)

	// XXX correct dir?
	dir, err := ioutil.TempDir("", "pitd")
	Ck(err)
	// log.Debugf(os.Stderr, "bundle dir: %s\n", dir)
	err = os.Chdir(dir)
	Ck(err)

	cntr.dir = dir

	return
}

func (cntr *Container) initconfig() (err error) {
	defer Return(&err)

	err = os.Chdir(cntr.dir)
	Ck(err)

	// create config file and set permissions
	config, err := os.OpenFile("config.json", os.O_RDWR|os.O_CREATE, 0755)
	Ck(err)

	spec, err := generate.New("linux")

	var exportOpts generate.ExportOptions
	// exportOpts.Seccomp = true

	spec.SetProcessTerminal(true)
	spec.SetProcessArgs(cntr.Args)

	//write to config.json
	err = spec.Save(config, exportOpts)
	Ck(err)

	return
}

func (cntr *Container) createimg() (err error) {
	defer Return(&err)

	// create docker image
	// XXX use docker API instead of CLI
	create := exec.Command("docker", "create", cntr.Path)
	out, err := create.CombinedOutput()
	if err != nil {
		return fmt.Errorf("docker create failed: %v:\n %s", err, out)
	}

	cntr.Cid = strings.TrimSpace(string(out))
	fmt.Fprintf(os.Stderr, "container id: %q\n", cntr.Cid)

	return
}

// creatrootfsFromDockerInage creates a root filesystem in the rootfs directory of the
// current working directory by exporting the docker image and untarring it
// XXX deprecate
func (cntr *Container) createRootfsFromDockerInage() (err error) {
	defer Return(&err)

	err = os.Chdir(cntr.dir)
	Ck(err)

	err = os.MkdirAll("rootfs", 0755)
	Ck(err)

	// export docker image
	export := exec.Command("docker", "export", cntr.Cid)
	// export.Stderr = os.Stderr
	export.Stderr = nil

	// untar to rootfs
	// XXX use archive/tar instead of CLI
	tarCmd := exec.Command("tar", "-C", "rootfs", "-xvf", "-")
	tarCmd.Stderr = os.Stderr
	tarCmd.Stdout = nil

	// pipe the export output to the tar input
	tarpipe, err := tarCmd.StdinPipe()
	Ck(err)
	export.Stdout = tarpipe

	fmt.Fprintf(os.Stderr, "starting tar\n")
	err = tarCmd.Start()
	Ck(err)

	fmt.Fprintf(os.Stderr, "starting export\n")
	err = export.Start()
	Ck(err)

	fmt.Fprintf(os.Stderr, "export waiting\n")
	err = export.Wait()
	if err != nil {
		fmt.Fprintf(os.Stderr, "export: %v\n", err)
	}

	tarpipe.Close()

	fmt.Fprintf(os.Stderr, "tar waiting\n")
	err = tarCmd.Wait()
	if err != nil {
		fmt.Fprintf(os.Stderr, "tar: %v\n", err)
	}

	return
}

// createRootFsFromTree creates a runc-compatible root filesystem in the rootfs
// subdirectory of the current working directory by unpacking the image tree
// from the database.  An image tree is an OCI archive that has been
// stored in the database.
func (cntr *Container) createRootFsFromTree() (err error) {
	defer Return(&err)

	err = os.Chdir(cntr.dir)
	Ck(err)

	err = os.MkdirAll("rootfs", 0755)
	Ck(err)

	path, err := pb.Path{}.New(cntr.pit.Db, cntr.Path)
	Ck(err)
	// tree is an io.Reader containing an OCI archive of the image
	tree, err := cntr.pit.Db.GetTree(path)
	Ck(err)

	// convert the oci archive to a tar stream using our new implementation
	tarRd, err := oci2tar(tree, "rootfs")
	Ck(err)
	defer tarRd.Close()

	// unpack the tar stream to the rootfs directory
	err = extract.Tar(context.Background(), tarRd, "rootfs", nil)
	Ck(err)
	return
}

func (cntr *Container) start() (err error) {
	defer Return(&err)

	fmt.Fprintf(os.Stderr, "starting container\n")
	if cntr.Name == "" {
		_, cntr.Name = filepath.Split(cntr.dir)
	}
	cntr.Cmd.Path = "/usr/bin/sudo"
	cntr.Cmd.Args = []string{"sudo", "runc", "run", cntr.Name}
	err = cntr.Start()
	Ck(err)
	fmt.Println("container started")

	return
}

// ImportImage imports a container image into the database and returns
// a tree.  The image name must be a docker image name, e.g.
// "docker.io/library/ubuntu:latest".  The image is stored in the database
// as an OCI archive.
func (pit *Pit) ImportImage(algo, img string) (tree *pb.Tree, err error) {
	tmpfile, err := ioutil.TempFile("", "*.oci")
	Ck(err)
	path := tmpfile.Name()
	defer os.Remove(path)
	cmd := exec.Command("skopeo", "copy", img, fmt.Sprintf("oci-archive:%s", path))
	fmt.Println(cmd.Args)
	err = cmd.Run()
	Ck(err)
	imgrd, err := os.Open(path)
	Ck(err)
	tree, err = pit.Db.PutStream(algo, imgrd)
	Ck(err)
	return
}

// oci2tar extracts the root filesystem from an OCI archive provided as an io.Reader.
// It does so by reading the tar stream into an in-memory temporary directory,
// using the layout package to parse the OCI image layout,
// selecting an appropriate image manifest, and then returning a tar stream
// for the flattened filesystem. The returned ReadCloser will remove the temporary
// directory when closed.
func oci2tar(reader io.Reader, rootfsPath string) (tar io.ReadCloser, err error) {
	// Create a temporary directory to hold the OCI layout in memory.
	tmpDir, err := os.MkdirTemp("", "oci-layout-*")
	if err != nil {
		return nil, fmt.Errorf("failed to create temp directory: %w", err)
	}

	// Extract the OCI archive (tar stream) into the temporary directory.
	err = extract.Tar(context.Background(), reader, tmpDir, nil)
	if err != nil {
		os.RemoveAll(tmpDir)
		return nil, fmt.Errorf("failed to extract OCI archive: %w", err)
	}

	// Load the OCI layout from the temporary directory.
	lp, err := layout.FromPath(tmpDir)
	if err != nil {
		os.RemoveAll(tmpDir)
		return nil, fmt.Errorf("failed to load OCI layout from temp directory: %w", err)
	}

	// Read the image index from the layout.
	index, err := lp.ImageIndex()
	if err != nil {
		os.RemoveAll(tmpDir)
		return nil, fmt.Errorf("failed to read image index: %w", err)
	}

	// Get the image manifest - for single-platform images, we use the first matching option.
	img, err := getImageFromIndex(index, "linux", "amd64")
	if err != nil {
		os.RemoveAll(tmpDir)
		return nil, fmt.Errorf("failed to get image from index: %w", err)
	}

	// Extract the flattened filesystem into a tar stream.
	rootfsReader := mutate.Extract(img)
	// Wrap the reader so that when closed the temp directory is removed.
	return &tempDirReadCloser{
		ReadCloser: rootfsReader,
		tmpDir:     tmpDir,
	}, nil
}

// getImageFromIndex selects an appropriate image from a multi-manifest index
// based on the specified OS and architecture requirements
func getImageFromIndex(index interface {
	ImageIndex() (interface {
		IndexManifest() (*mutate.IndexManifest, error)
	}, error)
	Image(digest any) (interface{}, error)
}, targetOS, targetArch string) (interface{}, error) {
	// We first get the index manifest.
	indexManifest, err := index.ImageIndex().IndexManifest()
	if err != nil {
		return nil, fmt.Errorf("failed to get index manifest: %w", err)
	}

	// Look for a manifest that matches our target platform.
	for _, desc := range indexManifest.Manifests {
		if desc.Platform != nil &&
			desc.Platform.OS == targetOS &&
			desc.Platform.Architecture == targetArch {
			// Found a matching platform, get the image.
			img, err := index.Image(desc.Digest)
			if err != nil {
				return nil, fmt.Errorf("failed to get image for digest %s: %w", desc.Digest, err)
			}
			return img, nil
		}
	}

	// If no platform-specific manifest is found, try to use the first manifest.
	if len(indexManifest.Manifests) > 0 {
		desc := indexManifest.Manifests[0]
		img, err := index.Image(desc.Digest)
		if err != nil {
			return nil, fmt.Errorf("failed to get first image from index: %w", err)
		}
		return img, nil
	}

	return nil, fmt.Errorf("no suitable image manifest found in index")
}

// XXX remove
func extractTarToDir(tarReader io.ReadCloser, destDir string) error {
	tr := tar.NewReader(tarReader)

	for {
		header, err := tr.Next()
		if err == io.EOF {
			break
		}
		if err != nil {
			return err
		}

		target := filepath.Join(destDir, header.Name)

		switch header.Typeflag {
		case tar.TypeDir:
			if err := os.MkdirAll(target, 0755); err != nil {
				return err
			}
		case tar.TypeReg:
			if err := os.MkdirAll(filepath.Dir(target), 0755); err != nil {
				return err
			}

			file, err := os.Create(target)
			if err != nil {
				return err
			}

			_, err = io.Copy(file, tr)
			file.Close()
			if err != nil {
				return err
			}
		}
	}
	return nil
}
