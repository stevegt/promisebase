digraph Layers {
  rankdir=TB;
  node [shape=box, style=filled, fillcolor=white,
  fontname="monospace"];

  UI [label="User Interfaces\n(CLI, Web, FUSE)"];
  Message [label="Message Layer"];
  Timeline [label="Timeline & Versioning"];
  Ingest [label="Ingestion Layer"];
  HGraph [label="Hypergraph\nLayer\n(Git-like, Threads)"];
  DB [label="High-Level Database\n(db) Layer"];
  Refs [label="Refs\n(Logical Ref Layer)"];
  HashKV [label="Content-Addressable\n(hashkv) Layer"];
  Rabin [label="Rabin Chunking"];
  KV_Hashed [label="KV Store\n(Hashed Objects)"];
  KV_Refs [label="KV Store\n(Refs)"];
  DirTree [label="Directory Tree\nImport/Export"];
  ContainerImage [label="Container Image"];

  // Primary flows from multiple roots.
  UI -> DB [label="0.90", color="green"];
  Message -> HGraph [label="0.88", color="green"];
  Timeline -> HGraph [label="0.88", color="green"];
  Ingest -> DB [label="0.75", color="yellow"];
  HGraph -> DB [label="0.80", color="green"];

  // Alternative connections from roots.
  UI -> HashKV [label="0.65", color="red"];
  Message -> HashKV [label="0.80", color="green"];
  Timeline -> HashKV [label="0.80", color="green"];
  Ingest -> KV_Hashed [label="0.70", color="yellow"];
  UI -> Refs [label="0.70", color="yellow"];

  // Ref integration via storage backend.
  HGraph -> Refs [label="0.90", color="green"];
  Refs -> KV_Refs [label="0.85", color="green"];

  // High-level DB flows.
  DB -> HashKV [label="0.90", color="green"];
  DB -> KV_Hashed [label="0.70", color="yellow"];

  // Rabin chunking is placed above hashkv.
  HashKV -> Rabin [label="0.95", color="green"];
  Rabin -> KV_Hashed [label="0.95", color="green"];

  // Directory tree module integrates with several layers.
  DB -> DirTree [label="0.85", color="green"];
  DirTree -> KV_Hashed [label="0.80", color="green"];
  DirTree -> HashKV [label="0.80", color="green"];
  DirTree -> Refs [label="0.85", color="green"];

  // Container image layer as an alternative UI leaf.
  UI -> ContainerImage [label="0.75", color="yellow"];
  ContainerImage -> DirTree [label="0.90", color="green"];

  // Alternative paths from Refs directly to KV.
  Refs -> KV_Refs [label="0.85", color="green"];
}
